# GitHub Pages에는 각 영상의 index.html과 assets/만 올려요.
# transcript.md, summary.md, content.json, sections/ 등은 로컬에만 남아요.
/*
!/.gitignore
!/.nojekyll
!/index.html
!/.pages/
!/*/
/skill-dev/
/.claude/
/*/*
!/*/index.html
!/*/assets/
!/.pages/*
.DS_Store
# 에이전트용 작업 지침과 로컬 체크리스트는 올리지 않아요.
/CLAUDE.md
/rerun-checklist.md
